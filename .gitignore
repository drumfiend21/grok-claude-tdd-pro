# claude-tdd-pro plugin sync cache (shallow clones written by scripts/sync-plugin.sh).
# Never commit upstream snapshots into this tree — that would violate R-2 (no vendoring).
.harness/plugin-cache/

# Handoff documents + decision trails written at runtime by the harness scripts
# (scripts/smoke-e2e.sh and, later, the real Grok orchestrator). These are
# per-ticket runtime artifacts — useful for inspection, not durable repo state.
.harness/handoffs/
.harness/trails/

# Per-ticket provenance manifests written by scripts/emit-manifest.sh
# (TICKET-010.a / ADR-0019). Index-only artifacts pointing at the three
# source surfaces above; same runtime-not-durable role as handoffs/ and
# trails/.
.harness/audit/

# Per-session Cursor working artifacts (reserved by TICKET-013 / ADR-0014; not
# used at v1). .cursor/rules/*.mdc IS committed (generator output, checked in
# so fresh clones have it before sync-plugin.sh --ensure runs).
.harness/cursor-sessions/

# Generated rule registry from the plugin's standards pipeline (TICKET-032 /
# ADR-0037). Written by scripts/standards-sync.sh at session start; aggregates
# .harness/plugin-cache/claude-tdd-pro/generated-code-quality-standards/ into
# a single JSON registry consumed by both Grok and Claude at session start.
.harness/rules/

# Architecture-consult cache (TICKET-034 / ADR-0039 — SUPERSEDED by ADR-0040).
# The dynamic consult mechanism is deprecated; this entry stays so legacy cache
# artifacts (if any) remain ignored. New work uses static context injection.
.harness/cache/

# Static planner-context (TICKET-035 / ADR-0040). Derived artifact copied from
# the pinned plugin's docs/PROJECT_CONTEXT_FOR_PLANNER.md by sync-plugin.sh
# --ensure. Plugin pin bumps refresh it; never committed to the harness tree
# (R-2 versioned-consumption: source-of-truth lives in the plugin).
.harness/context/

# Operator-local external-app pointer (TICKET-070 / ADR-0059, "Fix D"). Names the
# app_root tree GCTP builds + enforces for the user; environment-specific, so it is
# operator-local and gitignored. The tracked .harness/app.json.example documents the
# shape; scripts/app-root.sh resolves + hard-guards it.
.harness/app.json

# Operator-local standards-refresh cadence + CTP freshness baseline (TICKET-075 /
# ADR-0064). standards-refresh.json holds the chosen cadence + last-refresh timestamps
# (environment-specific); standards-cache/ is where CTP's initial-refresh.sh seeds its
# per-source freshness state. Both operator-local; .harness/standards-refresh.json.example
# documents the shape.
.harness/standards-refresh.json
.harness/standards-cache/

# OS / editor noise
.DS_Store
*.swp
